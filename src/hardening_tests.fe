#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn rejects_stale_completion_after_reopening() uses (evm: mut Evm) {
    let proof = evm.create2<TradeProof>(value: Wei::zero(), args: (), salt: 0)
    let payer = evm.address()
    let nonce: u256 = evm.call(
        addr: proof, gas: 500000, value: ether(1),
        message: TradeProofMsg::Open {
            worker: payer, customer: payer, specification_hash: 1001
        },
    )
    let _: Wei = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Refund { nonce: nonce, to: Address::new(0x5678) },
    )

    let _: u256 = evm.call(addr: proof, gas: 500000, value: ether(1),
        message: TradeProofMsg::Open {
            worker: payer, customer: payer, specification_hash: 3003 },
    )
    let _: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Complete { payer, nonce: nonce, evidence_hash: 2002 },
    )
}
