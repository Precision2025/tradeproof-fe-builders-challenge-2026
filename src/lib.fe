// TradeProof: one active, two-party-approved work-order milestone per payer.
// Written for the Fe Builders Challenge 2026 (Fe 26.5.0).
// Never deploy with real funds without audit and complete adversarial testing.
use std::evm::StorageMap

msg TradeProofMsg {
    #[selector = sol("open(address,address,uint256)")]
    Open { worker: Address, customer: Address, specification_hash: u256 } -> u256,
    #[selector = sol("complete(address,uint256,uint256)")]
    Complete { payer: Address, nonce: u256, evidence_hash: u256 } -> bool,
    #[selector = sol("approve(address,uint256,uint256)")]
    Approve { payer: Address, nonce: u256, evidence_hash: u256 } -> bool,
    #[selector = sol("release(address,uint256,address)")]
    Release { payer: Address, nonce: u256, to: Address } -> Wei,
    #[selector = sol("refund(uint256,address)")]
    Refund { nonce: u256, to: Address } -> Wei,
    #[selector = sol("statusOf(address)")]
    StatusOf { payer: Address } -> u256,
    #[selector = sol("nonceOf(address)")]
    NonceOf { payer: Address } -> u256,
    #[selector = sol("amountOf(address)")]
    AmountOf { payer: Address } -> Wei,
    #[selector = sol("specificationOf(address)")]
    SpecificationOf { payer: Address } -> u256,
    #[selector = sol("evidenceOf(address)")]
    EvidenceOf { payer: Address } -> u256,
}

#[event]
struct MilestoneOpened {
    #[indexed]
    payer: Address,
    nonce: u256,
    worker: Address,
    customer: Address,
    amount: Wei,
    specification_hash: u256,
}

#[event]
struct MilestoneCompleted {
    #[indexed]
    payer: Address,
    nonce: u256,
    evidence_hash: u256,
}

#[event]
struct MilestoneApproved {
    #[indexed]
    payer: Address,
    nonce: u256,
    evidence_hash: u256,
}

#[event]
struct MilestoneSettled {
    #[indexed]
    payer: Address,
    nonce: u256,
    recipient: Address,
    amount: Wei,
    refunded: bool,
}

// State: 0=unused, 1=funded, 2=completed, 3=approved, 4=released, 5=refunded.
// A payer may reuse their slot only after state 4 or 5; each new milestone
// receives a higher nonce so old completion and approval messages cannot replay.
pub contract TradeProof uses (ctx: Ctx, call: mut Call, log: mut Log) {
    mut statuses: StorageMap<Address, u256>,
    mut nonces: StorageMap<Address, u256>,
    mut workers: StorageMap<Address, Address>,
    mut customers: StorageMap<Address, Address>,
    mut specifications: StorageMap<Address, u256>,
    mut evidence: StorageMap<Address, u256>,
    mut amounts: StorageMap<Address, Wei>,

    init() {}

    recv TradeProofMsg {
        #[payable]
        Open { worker, customer, specification_hash } -> u256
        uses (
            ctx,
            mut statuses,
            mut nonces,
            mut workers,
            mut customers,
            mut specifications,
            mut evidence,
            mut amounts,
            mut log,
        )
        {
            let payer = ctx.caller()
            let previous = statuses.get(key: payer)
            assert!(
                previous == 0 || previous == 4 || previous == 5,
                "Active milestone exists",
            )
            assert!(ctx.value() > Wei::zero(), "Milestone must be funded")
            assert!(worker != Address::new(0), "Worker missing")
            assert!(customer != Address::new(0), "Customer missing")
            assert!(specification_hash != 0, "Specification missing")
            let nonce = nonces.get(key: payer) + 1
            nonces.set(key: payer, value: nonce)
            workers.set(key: payer, value: worker)
            customers.set(key: payer, value: customer)
            specifications.set(key: payer, value: specification_hash)
            evidence.set(key: payer, value: 0)
            amounts.set(key: payer, value: ctx.value())
            statuses.set(key: payer, value: 1)
            log.emit(
                MilestoneOpened {
                    payer,
                    nonce,
                    worker,
                    customer,
                    amount: ctx.value(),
                    specification_hash,
                },
            )
            nonce
        }

        Complete { payer, nonce, evidence_hash } -> bool
        uses (ctx, mut statuses, nonces, workers, mut evidence, mut log)
        {
            assert!(nonces.get(key: payer) == nonce, "Stale milestone")
            assert!(statuses.get(key: payer) == 1, "Not funded")
            assert!(
                ctx.caller() == workers.get(key: payer),
                "Only worker can complete",
            )
            assert!(evidence_hash != 0, "Evidence missing")
            evidence.set(key: payer, value: evidence_hash)
            statuses.set(key: payer, value: 2)
            log.emit(MilestoneCompleted { payer, nonce, evidence_hash })
            true
        }

        Approve { payer, nonce, evidence_hash } -> bool
        uses (ctx, mut statuses, nonces, customers, evidence, mut log)
        {
            assert!(nonces.get(key: payer) == nonce, "Stale milestone")
            assert!(statuses.get(key: payer) == 2, "Not completed")
            assert!(
                ctx.caller() == customers.get(key: payer),
                "Only customer can approve",
            )
            assert!(
                evidence.get(key: payer) == evidence_hash,
                "Evidence mismatch",
            )
            statuses.set(key: payer, value: 3)
            log.emit(MilestoneApproved { payer, nonce, evidence_hash })
            true
        }

        Release { payer, nonce, to } -> Wei uses (
            ctx,
            mut statuses,
            nonces,
            workers,
            mut amounts,
            mut call,
            mut log,
        ) {
            assert!(nonces.get(key: payer) == nonce, "Stale milestone")
            assert!(
                statuses.get(key: payer) == 3,
                "Customer approval required",
            )
            assert!(
                ctx.caller() == workers.get(key: payer),
                "Only worker can release",
            )
            assert!(to != Address::new(0), "Payment destination missing")
            let amount = amounts.get(key: payer)
            let recipient = to
            assert!(amount > Wei::zero(), "Nothing to release")
            // Effects before interaction: block reentrant double release.
            amounts.set(key: payer, value: Wei::zero())
            statuses.set(key: payer, value: 4)
            assert!(
                call.send_value(addr: recipient, gas: ctx.gas(), value: amount).success(),
                "Payment failed",
            )
            log.emit(
                MilestoneSettled { payer, nonce, recipient, amount, refunded: false },
            )
            amount
        }

        // A payer may recover a milestone only before the worker completes it.
        // Disputed/completed work needs an off-chain resolution process.
        Refund { nonce, to } -> Wei uses (
            ctx,
            mut statuses,
            nonces,
            mut amounts,
            mut call,
            mut log,
        ) {
            let payer = ctx.caller()
            assert!(nonces.get(key: payer) == nonce, "Stale milestone")
            assert!(
                statuses.get(key: payer) == 1,
                "Only an uncompleted milestone can refund",
            )
            assert!(to != Address::new(0), "Refund destination missing")
            let amount = amounts.get(key: payer)
            assert!(amount > Wei::zero(), "Nothing to refund")
            amounts.set(key: payer, value: Wei::zero())
            statuses.set(key: payer, value: 5)
            assert!(
                call.send_value(addr: to, gas: ctx.gas(), value: amount).success(),
                "Refund failed",
            )
            log.emit(
                MilestoneSettled { payer, nonce, recipient: to, amount, refunded: true },
            )
            amount
        }

        StatusOf { payer } -> u256 uses statuses {
            statuses.get(key: payer)
        }
        NonceOf { payer } -> u256 uses nonces {
            nonces.get(key: payer)
        }
        AmountOf { payer } -> Wei uses amounts {
            amounts.get(key: payer)
        }
        SpecificationOf { payer } -> u256 uses specifications {
            specifications.get(key: payer)
        }
        EvidenceOf { payer } -> u256 uses evidence {
            evidence.get(key: payer)
        }
    }
}
