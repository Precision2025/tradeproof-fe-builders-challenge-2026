}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn cannot_release_a_settled_milestone_twice() uses (evm: mut Evm) {
    let proof = evm.create2<TradeProof>(value: Wei::zero(), args: (), salt: 0)
    let payer = evm.address()
    let nonce: u256 = evm.call(
        addr: proof, gas: 500000, value: ether(1),
        message: TradeProofMsg::Open {
            worker: payer, customer: payer, specification_hash: 1001
        },
    )
    let _: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Complete { payer, nonce, evidence_hash: 2002 },
    )
    let _: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Approve { payer, nonce, evidence_hash: 2002 },
    )
    let _: Wei = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Release { payer, nonce, to: Address::new(0x1234) },
    )
    let _: Wei = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Release { payer, nonce, to: Address::new(0x1234) },
    )
}