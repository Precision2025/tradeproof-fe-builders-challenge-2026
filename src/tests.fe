// Test vectors for TradeProof on an isolated EVM; run with `fe test`.
use ingot::{TradeProof, TradeProofMsg}
use std::evm::ether

#[test(balance = 10_000_000_000_000_000_000)]
fn completed_and_approved_milestone_releases_escrow() uses (evm: mut Evm) {
    let proof = evm.create2<TradeProof>(value: Wei::zero(), args: (), salt: 0)
    let payer = evm.address()
    // A separate customer address requires caller impersonation in integration tests.
    // This unit test isolates the state machine with the test actor as both roles.
    let nonce: u256 = evm.call(
        addr: proof, gas: 500000, value: ether(1),
        message: TradeProofMsg::Open {
            worker: payer, customer: payer, specification_hash: 1001
        },
    )
    assert!(nonce == 1)
    let status: u256 = evm.call(
        addr: proof, gas: 100000, value: Wei::zero(),
        message: TradeProofMsg::StatusOf { payer },
    )
    assert!(status == 1)
    let complete: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Complete { payer, nonce, evidence_hash: 2002 },
    )
    assert!(complete)
    let approve: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Approve { payer, nonce, evidence_hash: 2002 },
    )
    assert!(approve)
    let released: Wei = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Release { payer, nonce, to: Address::new(0x1234) },
    )
    assert!(released == ether(1))
    assert!(evm.balance(Address::new(0x1234)) == ether(1))
    let amount: Wei = evm.call(
        addr: proof, gas: 100000, value: Wei::zero(),
        message: TradeProofMsg::AmountOf { payer },
    )
    assert!(amount == Wei::zero())
    let final_status: u256 = evm.call(
        addr: proof, gas: 100000, value: Wei::zero(),
        message: TradeProofMsg::StatusOf { payer },
    )
    assert!(final_status == 4)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn cannot_release_before_customer_approval() uses (evm: mut Evm) {
    let proof = evm.create2<TradeProof>(value: Wei::zero(), args: (), salt: 0)
    let payer = evm.address()
    let nonce: u256 = evm.call(
        addr: proof, gas: 500000, value: ether(1),
        message: TradeProofMsg::Open {
            worker: payer, customer: payer, specification_hash: 1001
        },
    )
    let _: Wei = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Release { payer, nonce, to: Address::new(0x1234) },
    )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn customer_cannot_approve_wrong_evidence_hash() uses (evm: mut Evm) {
    let proof = evm.create2<TradeProof>(value: Wei::zero(), args: (), salt: 0)
    let payer = evm.address()
    let nonce: u256 = evm.call(
        addr: proof, gas: 500000, value: ether(1),
        message: TradeProofMsg::Open {
            worker: payer, customer: payer, specification_hash: 1001
        },
    )
    let _: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Complete { payer, nonce, evidence_hash: 2002 },
    )
    let _: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Approve { payer, nonce, evidence_hash: 3003 },
    )
}

