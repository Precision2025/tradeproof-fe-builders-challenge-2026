            worker: payer, customer: payer, specification_hash: 1001
        },
    )
    let _: bool = evm.call(
        addr: proof, gas: 200000, value: Wei::zero(),
        message: TradeProofMsg::Complete { payer, nonce, evidence_hash: 2002 },
